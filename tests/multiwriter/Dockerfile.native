# syntax=docker/dockerfile:1
FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party ./third_party
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY mount ./mount
RUN CGO_ENABLED=0 go build -trimpath -o /out/afs ./cmd/afs

FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends redis-server procps fuse3 nfs-common \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/afs /usr/local/bin/afs
COPY scripts/multiwriter_lab.py scripts/native_multiwriter_lab.py scripts/native_lab_supervisor.py /lab/scripts/
WORKDIR /lab
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
ENTRYPOINT ["python3", "/lab/scripts/native_lab_supervisor.py", "--binary", "/usr/local/bin/afs"]
